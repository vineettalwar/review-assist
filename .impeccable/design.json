      "css": ".ds-toggle{display:inline-block;width:38px;height:22px;border-radius:999px;background:#cfd5e0;position:relative}.ds-toggle::after{content:\"\";position:absolute;width:16px;height:16px;border-radius:50%;background:#fff;top:3px;left:3px;transition:left .2s cubic-bezier(.16,1,.3,1);box-shadow:0 1px 2px rgba(16,21,34,.2)}.ds-toggle.on{background:#2346e0}.ds-toggle.on::after{left:19px}.ds-toggle.locked{opacity:.5;cursor:not-allowed}"
