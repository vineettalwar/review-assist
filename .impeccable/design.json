      "name": "Sheet + Carbon Stack",
      "kind": "card",
      "refersTo": "sheet",
      "description": "Signature: ink-bordered sheet over an offset carbon duplicate.",
      "html": "<div class=\"ds-stack\"><div class=\"ds-carbon\"><div>Really good cleaning at Lopez Dental. I'll be back.</div></div><div class=\"ds-sheet\"><div class=\"ds-sheet-head\"><span>NO. 0241</span><span class=\"ds-stamp\">COPIED</span></div><div class=\"ds-draft\">Really good cleaning at Lopez Dental. I'll be back.</div></div></div>",
      "css": ".ds-stack{position:relative;padding:0 10px 30px 0;width:320px}.ds-carbon{position:absolute;left:10px;right:0;top:30px;bottom:0;background:var(--carbon-wash,#e9eefb);border:1px solid #2346e0;border-radius:3px;color:#2346e0;font-size:16px;line-height:1.55;padding:0 18px 3px;display:flex;flex-direction:column;justify-content:flex-end}.ds-sheet{position:relative;background:#fff;border:1px solid #101522;border-radius:3px;padding:16px 18px 14px;color:#101522}.ds-sheet-head{display:flex;justify-content:space-between;font-size:11px;letter-spacing:.08em;color:#646c7d;margin-bottom:8px}.ds-stamp{font-weight:700;letter-spacing:.14em;color:#2346e0;border:1.5px solid #2346e0;padding:2px 6px;border-radius:2px;transform:rotate(-4deg)}.ds-draft{font-size:17px;line-height:1.55}.ds-sheet:focus-within{box-shadow:0 0 0 3px #e9eefb}"
    },
